<krpano>
	
	
	
	<layer name="startpic_container"
preload="true"
alpha="1"
handcursor="true"
enabled="true"
children="true"
visible="true"
zorder="90"
type="container"
maskchildren="true"
keep="true"
width="100%"
height="100%"
bgcolor="0xe5f8ff"
bgalpha="1" >
 
<layer name="skin_title_logo3"
zorder="100"
keep="true"
x="0"
y="-80"
align="center"
url="logo-vr-2.png"
scale="0.5"
alpha="0"
onloaded="tween(alpha,1.0);tween(layer[skin_title_pr].alpha,1.0);"
onclick="tween(layer[startpic_container].ox,-3500,1);
delayedcall(2,set(layer[startpic_container].enabled,false);
set(layer[startpic_container].visible,false));
stopdelayedcall(startpic1);stopdelayedcall(startpic2);"
enabled="false" />
 
<layer name="skin_title_pr"
bgcolor="0xe5f8ff"
glowcolor=""
visible="true"
keep="true"
alpha="0"
onloaded=""
children="false"
align="center"
zorder="100"
autowidth="auto"
height="10"
url="%SWFPATH%/plugins/textfield.swf"
html="加载中···"
css="text-align:center; color:#9B8179; font-size:16px;"
x="0"
y="0"
onclick="tween(layer[startpic_container].ox,-3500,1);
delayedcall(2,set(layer[startpic_container].enabled,false);
set(layer[startpic_container].visible,false));
stopdelayedcall(startpic1);stopdelayedcall(startpic2);"
enabled="false"
 
/>
 
</layer>

<events name="startlogoevents" keep="true"
onloadcomplete="
ifnot(layer[skin_title_logo3].enabled,
set(layer[skin_title_logo3].enabled,true);
set(layer[skin_title_pr].enabled,true);
delayedcall(startpic1,2,tween(layer[startpic_container].ox,-3500,1));
delayedcall(startpic2,2,set(layer[startpic_container].enabled,false);set(layer[startpic_container].visible,false));)
"/>
 

	
	
</krpano>