<krpano>
	
	<plugin name="mapnav" keep="true" device="html5"
	        url="panomap.js"
	        lat="36.322796"
	        lng="120.457540"
	        title="
绿地国科健康科技小镇营销中心"
	        desc="山东省青岛市城阳区城阳街道东旺疃村"
	        />

	
	
	<!-- 
		 lat和lng为目标点的经纬度。位置的经纬度可通过腾讯地图的位置拾取器获得。
         http://lbs.qq.com/tool/getpoint/index.html
         title为目标点的名称，desc为目标点的描述，该项可以为空或者不写；但是lat,lng和title为必须要填写的，否则无法正确导航
     -->

<layer name="nav_btn" keep="true" style="skin_base|skin_glow" crop="0|840|120|120" scale="0.5" align="righttop" x="0" y="190"  onclick="plugin[mapnav].showmap()" />


</krpano>
