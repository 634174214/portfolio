<krpano>
	
	
	
	<plugin name="qrcode" keep="true"
	        url="qrcode.js"
			onloaded="addQR();"
	/>
	
			
	<action  name="addQR"  devices="desktop">
		 plugin[qrcode].get_qr_image(new_url);
		 set(layer[QR].url,get(new_url));
	</action>
	

	<settings 
		mini-erma_bgcolor="0x000000"
		mini-erma_bgalpha="0.8"
		mini-erma_border_radius="6 6 6 6"
		mini-erma_css="color:#FFFFFF; font-family:Arial;"
		/>

	
	
	<events name="weather_event" 

     />
     
     
     
     
   
	<!--弹窗-->
		<layer name="erma-base" keep="true" type="container" align="center" x="-3330" width="60%" height="60%" bgcolor="get:settings.mini-erma_bgcolor" bgalpha="get:settings.mini-erma_bgalpha" bgroundedge="get:settings.mini-erma_border_radius" bgcapture="true"  children="false" scalechildren="true"  devices="desktop" zorder="8990"  >
		
	 <layer name="er-weima" keep="true" type="container"  align="center"   width="50%" height="380px" >
	      <layer name="QR" 
		   alpha="1" scale="1"
			isMiddle="false" 
			width="300px"
			height="300px"
			align="center"
           />
	     <layer name="desc_text_ti" type="text" keep="true" width="100%" height="30px"  align="leftbottom"  html="扫描二维码手机上看" css="text-align:center; color:#fff; font-family:Arial; font-size:15px;" bgalpha="0"/>
       </layer>	

        
	</layer>

	<!--test button-->
	<layer name="erma_icon" keep="true" style="skin_base|skin_glow" crop="0|720|120|120" scale="0.5" align="righttop" x="0" y="130" zorder="1" onover="tween(alpha,1)" onout="tween(alpha,1)" onclick="toggle_erma(); switch(crop, 0|720|120|120, 120|720|120|120);"  devices="desktop"/>

	<action name="toggle_erma" >
		if(layer[erma-base].x GT 0,
			tween(layer[erma-base].x,-3300);
			,
			tween(layer[erma-base].x,1);
		)	
	</action>



</krpano>